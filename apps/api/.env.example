ONEFINANCE_ENV=development            # development | test | production
ONEFINANCE_DATABASE_URL=postgresql+psycopg://onefinance:onefinance@localhost:5432/onefinance
ONEFINANCE_REDIS_URL=redis://localhost:6379/0
# 32 random bytes, base64. Required in production (generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
ONEFINANCE_CREDENTIAL_KEY=
ONEFINANCE_COOKIE_SECURE=false        # true behind HTTPS (enables __Host- cookie prefix)
ONEFINANCE_DEMO_MODE=true             # seeds clearly-labelled demo data; must be false in production
ONEFINANCE_ALLOW_MOCK_CONNECTORS=true # must be false in production
