# Copy to .env.production on the server and fill in. Never commit the filled-in file.

# Your domain, pointing (DNS A record) at the server. No https://, no trailing slash.
DOMAIN=1finance.example.com

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Encrypts stored bank/broker credentials. Generate with: openssl rand -base64 32
# Back it up somewhere safe — losing it makes stored connection credentials unreadable.
CREDENTIAL_KEY=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://<DOMAIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Default display currency for new accounts.
BASE_CURRENCY=EUR
